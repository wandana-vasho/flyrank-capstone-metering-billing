# Database. SQLite by default -- no setup needed. Swap for a Postgres URL
# (e.g. postgresql://user:pass@localhost:5432/billing) if you're running
# the optional docker-compose Postgres instead.
DATABASE_URL=sqlite:///./billing.db

# Stripe TEST MODE keys only. Leave both blank to run in $0 simulated mode
# (fake checkout sessions + locally-signed webhook events -- no Stripe
# account needed at all). Get free test-mode keys with no credit card at
# https://dashboard.stripe.com/test/apikeys once you want the real
# Checkout flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
